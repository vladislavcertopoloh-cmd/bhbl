@model WebApplication1.Models.Avvik

@{
    ViewData["Title"] = "Регистрация";
}

<!-- ПРЯМОЕ ПОДКЛЮЧЕНИЕ СТИЛЕЙ (если Layout не подхватил) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body { background-color: #f4f7f6; }
    .create-card { border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
    .form-label { font-weight: 600; color: #444; }
    .form-control:focus { border-color: #0d6efd; box-shadow: 0 0 0 0.25 disposable rgba(13, 110, 253, 0.25); }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card create-card">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 text-center">Регистрация нового авика</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label">Заголовок</label>
                            <input asp-for="Tittel" class="form-control" placeholder="Введите название..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Место происшествия</label>
                            <input asp-for="Sted" class="form-control" placeholder="Где это случилось?" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Описание проблемы</label>
                            <textarea asp-for="Beskrivelse" class="form-control" rows="4" placeholder="Опишите детали..."></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send-fill me-2"></i>Отправить запись
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary text-center">
                                Назад к списку
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>